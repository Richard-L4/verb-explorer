itle":"Give’r","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_002","region":"canadian","title":"Keener","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_003","region":"canadian","title":"Gong show","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_004","region":"canadian","title":"Hoser","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_005","region":"canadian","title":"Eh?","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_006","region":"canadian","title":"Sorry","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_007","region":"canadian","title":"Not bad","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_008","region":"canadian","title":"Take a kick at the can","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_009","region":"canadian","title":"Kerfuffle","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_010","region":"canadian","title":"Pitch in","category":"everyday_talk_attitude","categoryHeading":"Everyday talk and attitude"},{"id":"ca_011","region":"canadian","title":"Going up to the cottage","category":"home_money_everyday_life","categoryHeading":"Home, money and everyday life"},{"id":"ca_012","region":"canadian","title":"Snowbird","category":"home_money_everyday_life","categoryHeading":"Home, money and everyday life"},{"id":"ca_013","region":"canadian","title":"The hydro bill","category":"home_money_everyday_life","categoryHeading":"Home, money and everyday life"},{"id":"ca_014","region":"canadian","title":"Loonie / toonie","category":"home_money_everyday_life","categoryHeading":"Home, money and everyday life"},{"id":"ca_015","region":"canadian","title":"Chesterfield"