[{"id":"ser-vs-estar","title":"ser vs estar","triggers":[{"category":"wish","trigger":"quiero que","explanation":"Wanting someone else to do or be something is a wish, so the verb after que goes in the subjunctive.","examples":[{"difficulty":"easy","level":"A2","es":"Quiero que seas feliz.","en":"I want you to be happy.","form":"seas (ser)","note":"Different subjects (yo / tú) after a wish means que + subjunctive. Never 'quiero que eres'."},{"difficulty":"medium","level":"B1","es":"Quiero que estés tranquila durante la boda.","en":"I want you to be calm during the wedding.","form":"estés (estar)","note":"Estar keeps its written accent in estés, esté and estén. Only estemos has none."},{"difficulty":"hard","level":"B2","es":"Quiero que estés listo a las ocho.","en":"I want you to be ready at eight.","form":"estés (estar)","note":"Listo with estar means ready. 'Seas listo' would mean you should be clever.","contrast":{"es":"Quiero estar listo a las ocho.","en":"I want to be ready at eight.","note":"Same subject means infinitive. A different subject means que + subjunctive."}}]},{"category":"doubt","trigger":"no creo que","explanation":"Doubting or denying something removes the claim of fact, so the subjunctive is needed.","examples":[{"difficulty":"easy","level":"A2","es":"No creo que sea caro.","en":"I don't think it's expensive.","form":"sea (ser)","note":"No creo que = doubt, so sea, not es."},{"difficulty":"medium","level":"B1","es":"No creo que Marta esté en casa hoy.","en":"I don't think Marta is at home today.","form":"esté (estar)","note":"Location uses estar, and the subjunctive form esté keeps its accent."},{"difficulty":"hard","level":"B2","es":"No creo que el profesor sea aburrido.","en":"I don't think the teacher is boring.","form":"sea (ser)","note":"With ser, aburrido describes personality. With estar it would mean bored right now.","contrast":{"es":"Creo que el profesor es aburrido.","en":"I think the teacher is boring.","note":"Affirmative creo que takes the indicative. No creo que takes the subjunctive."}}]},{"category":"conjunction","trigger":"cuando","explanation":"Cuando about a future event that hasn't happened yet takes the subjunctive.","examples":[{"difficulty":"easy","level":"A2","es":"Cuando estés listo, llámame.","en":"When you're ready, call me.","form":"estés (estar)","note":"The ready moment is still in the future, so the subjunctive."},{"difficulty":"medium","level":"B1","es":"Cuando sea mayor, quiero ser piloto.","en":"When I grow up, I want to be a pilot.","form":"sea (ser)","note":"Sea is irregular. It is not 'sía' or 'sera'. Cuando + future idea = subjunctive."},{"difficulty":"hard","level":"B2","es":"Cuando estés en Madrid, te enseñaré el barrio.","en":"When you're in Madrid, I'll show you the neighbourhood.","form":"estés (estar)","note":"One future visit that hasn't happened yet, so the subjunctive.","contrast":{"es":"Cuando estás en Madrid, te enseño el barrio.","en":"Whenever you're in Madrid, I show you the neighbourhood.","note":"A habit or fact uses the indicative. A future event uses the subjunctive."}}]}]},{"id":"fue-vs-era","title":"fue vs era"},{"id":"por-vs-para","title":"por vs para"},{"id":"saber-vs-conocer","title":"saber vs conocer"},{"id":"salir-vs-quedar","title":"salir vs quedar"},{"id":"llevar-vs-hacer","title":"llevar vs hacer (time)"},{"id":"pedir-vs-preguntar","title":"pedir vs preguntar"},{"id":"poder-vs-saber","title":"poder vs saber (can)"},{"id":"deber-vs-tener-que","title":"deber vs tener que"},{"id":"ir-vs-venir","title":"ir vs venir"},{"id":"traer-vs-llevar","title":"traer vs llevar"},{"id":"querer-vs-amar","title":"querer vs amar"},{"id":"mirar-vs-ver","title":"mirar vs ver"},{"id":"escuchar-vs-oir","title":"escuchar vs oír"},{"id":"acordarse-vs-recordar","title":"acordarse vs recordar"},{"id":"sentir-vs-sentirse","title":"sentir vs sentirse"},{"id":"pensar-vs-creer","title":"pensar vs creer"},{"id":"gastar-vs-pasar","title":"gastar vs pasar (spend)"},{"id":"hablar-vs-decir","title":"hablar vs decir"},{"id":"encontrar-vs-buscar","title":"encontrar vs buscar"},{"id":"perder-vs-faltar","title":"perder vs faltar"},{"id":"tocar-vs-jugar","title":"tocar vs jugar"},{"id":"volver-vs-regresar","title":"volver vs regresar"},{"id":"dejar-vs-salir","title":"dejar vs salir (leave)"},{"id":"ser-vs-parecer","title":"ser vs parecer"},{"id":"haber-solo","title":"haber"},{"id":"tener-solo","title":"tener"},{"id":"hacer-solo","title":"hacer"},{"id":"dar-solo","title":"dar"},{"id":"poner-solo","title":"poner"},{"id":"gustar-solo","title":"gustar"},{"id":"tomar-solo","title":"tomar"},{"id":"coger-solo","title":"coger"},{"id":"entrar-solo","title":"entrar"},{"id":"subir-vs-bajar","title":"subir vs bajar"},{"id":"tirar-vs-sacar","title":"tirar vs sacar"},{"id":"echar-solo","title":"echar"},{"id":"caer-solo","title":"caer"},{"id":"sentarse-solo","title":"sentar vs sentarse"},{"id":"seguir-solo","title":"seguir"},{"id":"esperar-solo","title":"esperar"},{"id":"conseguir-solo","title":"conseguir"},{"id":"crear-vs-creer","title":"crear vs creer"},{"id":"quedar-vs-quedarse","title":"quedar vs quedarse"},{"id":"volverse-vs-hacerse","title":"volverse vs hacerse (become)"},{"id":"dejar-de-vs-parar","title":"dejar de vs parar"},{"id":"acabar-vs-terminar","title":"acabar vs terminar"},{"id":"soler-vs-acostumbrarse","title":"soler vs acostumbrarse"},{"id":"darse-cuenta-vs-realizar","title":"darse cuenta vs realizar"},{"id":"asistir-vs-atender","title":"asistir vs atender"},{"id":"soportar-vs-apoyar","title":"soportar vs apoyar"},{"id":"introducir-vs-presentar","title":"introducir vs presentar"},{"id":"pretender-vs-fingir","title":"pretender vs fingir"},{"id":"avergonzado-vs-embarazada","title":"avergonzado vs embarazada"},{"id":"conducir-vs-manejar","title":"conducir vs manejar"},{"id":"probar-vs-intentar","title":"probar vs intentar"},{"id":"mover-vs-mudarse","title":"mover vs mudarse"},{"id":"aprender-vs-enseñar","title":"aprender vs enseñar"},{"id":"dar-vs-regalar","title":"dar vs regalar"},{"id":"prestar-vs-pedir-prestado","title":"prestar vs pedir prestado"},{"id":"llamar-vs-llamarse","title":"llamar vs llamarse"},{"id":"levantar-vs-levantarse","title":"levantar vs levantarse"},{"id":"ir-vs-irse","title":"ir vs irse"},{"id":"dormir-vs-dormirse","title":"dormir vs dormirse"},{"id":"estar-de-acuerdo-vs-acordar","title":"estar de acuerdo vs acordar"},{"id":"hacer-falta-vs-necesitar","title":"hacer falta vs necesitar"},{"id":"importar-vs-interesar","title":"importar vs interesar"},{"id":"funcionar-vs-trabajar","title":"funcionar vs trabajar"},{"id":"cumplir-solo","title":"cumplir"},{"id":"llegar-vs-alcanzar","title":"llegar vs alcanzar"},{"id":"quitar-vs-quitarse","title":"quitar vs quitarse"},{"id":"llevar-vs-vestirse","title":"llevar vs vestirse (wear)"},{"id":"ganar-vs-ganarse","title":"ganar vs ganarse"},{"id":"soñar-solo","title":"soñar"},{"id":"olvidar-vs-olvidarse","title":"olvidar vs olvidarse"},{"id":"notar-vs-fijarse","title":"notar vs fijarse"},{"id":"preocupar-vs-preocuparse","title":"preocupar vs preocuparse"},{"id":"resultar-solo","title":"resultar"},{"id":"sobrar-vs-bastar","title":"sobrar vs bastar"},{"id":"costar-vs-valer","title":"costar vs valer"},{"id":"durar-vs-tardar","title":"durar vs tardar"},{"id":"pagar-vs-cobrar","title":"pagar vs cobrar"},{"id":"mandar-vs-enviar","title":"mandar vs enviar"},{"id":"casarse-solo","title":"casarse"},{"id":"despedir-vs-despedirse","title":"despedir vs despedirse"},{"id":"morir-vs-matar","title":"morir vs matar"},{"id":"oler-vs-saber-a","title":"oler vs saber a"},{"id":"cerrar-vs-apagar","title":"cerrar vs apagar"},{"id":"arreglar-vs-arreglarse","title":"arreglar vs arreglarse"},{"id":"pegar-solo","title":"pegar"},{"id":"meter-vs-poner","title":"meter vs poner"},{"id":"andar-vs-caminar","title":"andar vs caminar"},{"id":"comprender-vs-entender","title":"comprender vs entender"},{"id":"discutir-vs-comentar","title":"discutir vs comentar"},{"id":"tratar-vs-tratarse","title":"tratar vs tratarse"},{"id":"dedicar-vs-dedicarse","title":"dedicar vs dedicarse"},{"id":"haber-que-vs-tener-que","title":"hay que vs tener que"},{"id":"aprobar-vs-suspender","title":"aprobar vs suspender"},{"id":"caber-solo","title":"caber"},{"id":"disfrutar-vs-gozar","title":"disfrutar vs gozar"}]
